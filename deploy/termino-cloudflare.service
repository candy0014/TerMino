[Unit]
Description=TerMino Cloudflare Tunnel
Wants=termino-websocket.service
After=termino-websocket.service
StartLimitIntervalSec=60
StartLimitBurst=10
ConditionPathExists=%h/.config/termino-cloudflare/token

[Service]
Type=exec
ExecStart=/usr/bin/python3 %h/termino-cloudflare/run_cloudflare_direct.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
