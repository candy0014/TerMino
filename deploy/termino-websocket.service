[Unit]
Description=TerMino WebSocket multiplayer gateway
Requires=termino-relay.service
After=termino-relay.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=exec
Environment=PYTHONPATH=%h/termino-websocket/current/lib
ExecStart=/usr/bin/python3 %h/termino-websocket/current/websocket_gateway.py
WorkingDirectory=%h/termino-websocket/current
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
