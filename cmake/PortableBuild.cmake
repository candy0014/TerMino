option(TETR_PORTABLE_BUILD "Build a relocatable game/server distribution" OFF)
option(TETR_PORTABLE_FULL_STATIC "Link all Linux runtime libraries statically" ON)
option(TETR_PORTABLE_RESET_SETTINGS "Use built-in defaults instead of copying player settings and bindings" OFF)
set(TETR_PORTABLE_DATA_DIR "${CMAKE_CURRENT_SOURCE_DIR}" CACHE PATH
    "Runtime directory containing .tetr and keybinding files to package")

if(NOT TETR_PORTABLE_BUILD)
    return()
endif()
if(TETR_BUILD_OPENGL AND NOT WIN32 AND TETR_PORTABLE_FULL_STATIC)
    message(FATAL_ERROR "OpenGL requires system graphics drivers. Configure graphics/both packages with -DTETR_PORTABLE_FULL_STATIC=OFF; terminal-only packages retain full static linking.")
endif()
if(NOT WIN32 AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Portable packaging supports Windows and Linux only")
endif()
if(NOT IS_DIRECTORY "${TETR_PORTABLE_DATA_DIR}")
    message(FATAL_ERROR "Runtime data directory does not exist: ${TETR_PORTABLE_DATA_DIR}")
endif()

if(MSVC)
    # Apply /MT to all libraries too, so the target PC needs no VC++ redist.
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    if(WIN32 OR TETR_PORTABLE_FULL_STATIC)
        include(CheckCXXSourceCompiles)
        set(CMAKE_REQUIRED_LINK_OPTIONS -static)
        set(CMAKE_REQUIRED_LIBRARIES Threads::Threads)
        check_cxx_source_compiles("#include <iostream>
            #include <thread>
            int main() { std::thread t([] { std::cout << 1; }); t.join(); }"
            TETR_PORTABLE_STATIC_LINK_WORKS)
        unset(CMAKE_REQUIRED_LINK_OPTIONS)
        unset(CMAKE_REQUIRED_LIBRARIES)
        if(NOT TETR_PORTABLE_STATIC_LINK_WORKS)
            message(FATAL_ERROR "Static C/C++ runtime libraries are required. On Linux install your toolchain's static libc/libstdc++ packages, or run package.sh --dynamic. See CMake's configure log for details.")
        endif()
        add_link_options(-static)
    else()
        # Keep only the system C library dynamic when full static is disabled.
        add_link_options(-static-libgcc -static-libstdc++)
    endif()
else()
    message(FATAL_ERROR "Portable packaging requires MSVC, GCC or Clang")
endif()

if(WIN32)
    set(TETR_PORTABLE_PLATFORM Windows)
else()
    set(TETR_PORTABLE_PLATFORM Linux)
endif()
set(_portable_cpu "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_GENERATOR_PLATFORM)
    set(_portable_cpu "${CMAKE_GENERATOR_PLATFORM}")
elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(_portable_cpu "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif()
string(TOLOWER "${_portable_cpu}" _portable_cpu)
if(_portable_cpu MATCHES "^(aarch64|arm64)$")
    set(TETR_PORTABLE_ARCH arm64)
elseif(_portable_cpu MATCHES "^(amd64|x86_64|x64|x86|win32|i[3-6]86)$")
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(TETR_PORTABLE_ARCH x64)
    else()
        set(TETR_PORTABLE_ARCH x86)
    endif()
else()
    set(TETR_PORTABLE_ARCH "${_portable_cpu}")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/portable-platform.txt"
    "${TETR_PORTABLE_PLATFORM}-${TETR_PORTABLE_ARCH}\n")
