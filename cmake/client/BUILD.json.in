{
  "schema": 1,
  "platform": "@CMAKE_SYSTEM_NAME@",
  "architecture": "@TETR_CLIENT_ARCH@",
  "frontend": "@TETR_CLIENT_FRONTEND@",
  "source_commit": "@TETR_CLIENT_COMMIT@",
  "source_dirty": @TETR_CLIENT_DIRTY@,
  "compiler": "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@",
  "linux_full_static": @TETR_CLIENT_STATIC@,
  "initial_data": "built-in settings; approved default map and preset libraries; no personal profiles or replays",
  "default_libraries": true,
  "graphics_minimum": "OpenGL 3.3 Core for opengl frontend"
}
