set(source [==[@PROJECT_SOURCE_DIR@]==])
set(destination "${CMAKE_INSTALL_PREFIX}")
set(frontend "@TETR_CLIENT_FRONTEND@")
file(MAKE_DIRECTORY "${destination}/.tetr/replay" "${destination}/licenses/websocket")
foreach(name LICENSE THIRD_PARTY_NOTICES.md)
    configure_file("${source}/${name}" "${destination}/${name}" COPYONLY)
endforeach()
foreach(name zzztoj_standalone/upstream/LICENSE.md third_party/cold-clear/LICENSE)
    configure_file("${source}/${name}" "${destination}/licenses/${name}" COPYONLY)
endforeach()
configure_file("${source}/resources/licenses/curl.txt" "${destination}/licenses/websocket/curl.txt" COPYONLY)
if(EXISTS "@CMAKE_CURRENT_BINARY_DIR@/websocket-licenses")
    file(INSTALL "@CMAKE_CURRENT_BINARY_DIR@/websocket-licenses/" DESTINATION "${destination}/licenses/websocket" TYPE DIRECTORY)
endif()
configure_file("${source}/cmake/client/README.txt" "${destination}/README.txt" COPYONLY)
if(frontend STREQUAL "opengl")
    set(executable tetr_gl)
else()
    set(executable tetr)
endif()
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
    configure_file("${source}/cmake/client/Play.bat.in" "${destination}/Play.bat" @ONLY)
    if("@TETR_BUILD_SERVER@")
        configure_file("${source}/cmake/portable/Server.bat" "${destination}/Server.bat" COPYONLY)
    endif()
else()
    configure_file("${source}/cmake/client/Play.sh.in" "@CMAKE_CURRENT_BINARY_DIR@/client-${frontend}-Play.sh" @ONLY)
    file(INSTALL "@CMAKE_CURRENT_BINARY_DIR@/client-${frontend}-Play.sh" DESTINATION "${destination}" TYPE PROGRAM RENAME Play.sh)
    if("@TETR_BUILD_SERVER@")
        file(INSTALL "${source}/cmake/portable/Server.sh" DESTINATION "${destination}" TYPE PROGRAM)
    endif()
endif()
