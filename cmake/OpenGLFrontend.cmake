# Only included for TETR_BUILD_OPENGL; terminal/headless never search graphics.
include(FetchContent)
if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()
option(TETR_GRAPHICS_FETCH_DEPS "Download pinned graphics dependencies when absent" ON)
option(TETR_GRAPHICS_BUNDLED_DEPS "Build pinned SDL/FreeType for portable packages" ${TETR_PORTABLE_BUILD})
if(NOT TETR_GRAPHICS_BUNDLED_DEPS AND NOT ANDROID)
    find_package(SDL3 3.2 CONFIG QUIET)
endif()
if(NOT TARGET SDL3::SDL3)
    if(NOT TETR_GRAPHICS_FETCH_DEPS)
        message(FATAL_ERROR "SDL3 >=3.2 required; install development files or enable TETR_GRAPHICS_FETCH_DEPS")
    endif()
    if(ANDROID)
        set(SDL_SHARED ON CACHE BOOL "" FORCE)
        set(SDL_STATIC OFF CACHE BOOL "" FORCE)
    else()
        set(SDL_SHARED OFF CACHE BOOL "" FORCE)
        set(SDL_STATIC ON CACHE BOOL "" FORCE)
    endif()
    set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
    set(SDL_TESTS OFF CACHE BOOL "" FORCE)
    set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
    foreach(subsystem JOYSTICK HAPTIC SENSOR CAMERA GPU RENDER)
        set(SDL_${subsystem} OFF CACHE BOOL "" FORCE)
    endforeach()
    if(NOT ANDROID)
        set(SDL_AUDIO OFF CACHE BOOL "" FORCE)
    endif()
    FetchContent_Declare(tetr_sdl
        URL https://www.libsdl.org/release/SDL3-3.4.18.tar.gz
        URL_HASH SHA256=9c75cf16330322c217dedd2e0609f1124f1b54b8633e763467b4684d0f4334a3)
    FetchContent_MakeAvailable(tetr_sdl)
endif()
if(ANDROID)
    target_link_libraries(tetr_render PRIVATE SDL3::SDL3)
endif()
if(NOT TETR_GRAPHICS_BUNDLED_DEPS AND NOT ANDROID)
    find_package(Freetype QUIET)
endif()
if(NOT TARGET Freetype::Freetype)
    if(NOT TETR_GRAPHICS_FETCH_DEPS)
        message(FATAL_ERROR "FreeType development files required or enable TETR_GRAPHICS_FETCH_DEPS")
    endif()
    set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
    set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
    set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
    set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
    set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
    FetchContent_Declare(tetr_freetype
        URL https://download.savannah.gnu.org/releases/freetype/freetype-2.14.1.tar.xz
        URL_HASH SHA256=32427e8c471ac095853212a37aef816c60b42052d4d9e48230bab3bdf2936ccc)
    FetchContent_MakeAvailable(tetr_freetype)
    add_library(Freetype::Freetype ALIAS freetype)
endif()

if(ANDROID)
    add_library(tetr_glad INTERFACE)
    target_link_libraries(tetr_glad INTERFACE GLESv3 EGL)
else()
    add_library(tetr_glad STATIC third_party/glad/src/gl.c)
    target_include_directories(tetr_glad PUBLIC third_party/glad/include)
endif()
add_library(tetr_graphical_session STATIC src/frontend/opengl/session.cpp src/frontend/opengl/session_scene.cpp)
target_link_libraries(tetr_graphical_session PUBLIC tetr_app tetr_presentation_context tetr_bot_legacy Threads::Threads)
add_library(tetr_sdl_input STATIC src/frontend/opengl/input.cpp src/frontend/opengl/text_events.cpp)
target_link_libraries(tetr_sdl_input PUBLIC tetr_headers SDL3::SDL3)
target_include_directories(tetr_sdl_input PUBLIC src/frontend/opengl)
add_library(tetr_window_config STATIC src/frontend/opengl/window_config.cpp)
target_link_libraries(tetr_window_config PUBLIC tetr_config)
target_include_directories(tetr_window_config PUBLIC src/frontend/opengl)
add_library(tetr_gl_renderer STATIC src/frontend/opengl/renderer.cpp src/frontend/opengl/menu_renderer.cpp src/frontend/opengl/application_renderer.cpp src/frontend/opengl/scene.cpp
    src/frontend/opengl/native_context.cpp src/frontend/opengl/render_thread.cpp)
target_link_libraries(tetr_gl_renderer PUBLIC tetr_graphical_session tetr_sdl_input tetr_glad Freetype::Freetype)
if(WIN32)
    target_link_libraries(tetr_gl_renderer PRIVATE opengl32 gdi32)
endif()
if(ANDROID)
    add_library(main SHARED src/frontend/android/main.cpp src/frontend/android/mobile_ui.cpp)
    target_link_libraries(main PRIVATE tetr_gl_renderer tetr_window_config android log)
    return()
endif()
if(BUILD_TESTING)
    tetr_test_module(mobile_controls_test tetr_graphical_tests tests/mobile_controls_test.cpp)
    target_sources(mobile_controls_test PRIVATE src/frontend/android/mobile_ui.cpp)
    target_link_libraries(mobile_controls_test PRIVATE tetr_gl_renderer)
    add_test(NAME mobile_controls COMMAND tetr_graphical_tests mobile_controls_test)
    set_tests_properties(mobile_controls PROPERTIES TIMEOUT 15)
endif()
add_executable(tetr_gl src/frontend/opengl/main.cpp)
target_link_libraries(tetr_gl PRIVATE tetr_gl_renderer tetr_window_config)
if(MINGW)
    target_link_options(tetr_gl PRIVATE -static)
endif()
add_custom_command(TARGET tetr_gl POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_directory
        "${PROJECT_SOURCE_DIR}/resources/fonts" "$<TARGET_FILE_DIR:tetr_gl>/resources/fonts")
install(TARGETS tetr_gl RUNTIME DESTINATION . COMPONENT OpenGLPreview)
install(DIRECTORY resources/fonts DESTINATION resources COMPONENT OpenGLPreview)
install(DIRECTORY resources/licenses DESTINATION resources COMPONENT OpenGLPreview)
install(FILES third_party/glad/LICENSE DESTINATION resources/licenses RENAME glad.txt COMPONENT OpenGLPreview)
install(FILES docs/OPENGL_PREVIEW.md DESTINATION . COMPONENT OpenGLPreview)
# A system shared SDL must be shipped by the platform packager. The pinned
# fallback builds SDL/FreeType statically; GPU drivers always stay system-owned.
if(WIN32)
    get_target_property(_sdl_type SDL3::SDL3 TYPE)
    if(_sdl_type STREQUAL "SHARED_LIBRARY")
        add_custom_command(TARGET tetr_gl POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
            "$<TARGET_FILE:SDL3::SDL3>" "$<TARGET_FILE_DIR:tetr_gl>")
        install(FILES "$<TARGET_FILE:SDL3::SDL3>" DESTINATION . COMPONENT OpenGLPreview)
    endif()
endif()
if(BUILD_TESTING)
    tetr_test_module(graphical_event_motion_test tetr_core_tests tests/graphical_event_motion_test.cpp)
    target_link_libraries(graphical_event_motion_test PRIVATE tetr_presentation)
    add_test(NAME graphical_event_motion COMMAND tetr_core_tests graphical_event_motion_test)
    set_tests_properties(graphical_event_motion PROPERTIES TIMEOUT 10)
    tetr_test_program(graphical_visual_test EXCLUDE_FROM_ALL tests/graphical_visual_test.cpp)
    target_sources(graphical_visual_test PRIVATE src/frontend/android/mobile_ui.cpp)
    target_link_libraries(graphical_visual_test PRIVATE tetr_gl_renderer)
    tetr_test_program(graphical_render_thread_test EXCLUDE_FROM_ALL tests/graphical_render_thread_test.cpp)
    target_link_libraries(graphical_render_thread_test PRIVATE tetr_gl_renderer)
    foreach(name graphical_session graphical_scene graphical_application graphical_input frontend_handling room_replay_graphical graphical_ui_interaction)
        tetr_test_module(${name}_test tetr_graphical_tests tests/${name}_test.cpp)
        target_link_libraries(${name}_test PRIVATE tetr_graphical_session tetr_sdl_input)
        add_test(NAME ${name} COMMAND tetr_graphical_tests ${name}_test)
        set_tests_properties(${name} PROPERTIES TIMEOUT 25)
    endforeach()
    # The complete application flow now exceeds 90 seconds on native Windows;
    # each individual transition retains its own short failure deadline.
    set_tests_properties(graphical_application PROPERTIES TIMEOUT 180 RESOURCE_LOCK udp3197)
    tetr_test_module(window_config_test tetr_core_tests tests/window_config_test.cpp)
    target_link_libraries(window_config_test PRIVATE tetr_window_config)
    add_test(NAME window_config COMMAND tetr_core_tests window_config_test)
endif()
