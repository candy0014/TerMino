# Separate, clean client components. They work in normal and portable builds
# and never read TETR_PORTABLE_DATA_DIR or copy a user's runtime directory.
find_package(Git QUIET)
set(TETR_DISTRIBUTION_COMMIT "" CACHE STRING "Source commit supplied by a cross-build orchestrator")
set(TETR_DISTRIBUTION_DIRTY "" CACHE STRING "Source dirty state supplied by a cross-build orchestrator")
set(TETR_CLIENT_COMMIT unknown)
set(TETR_CLIENT_DIRTY true)
if(Git_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
        OUTPUT_VARIABLE TETR_CLIENT_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
        OUTPUT_VARIABLE _client_status RESULT_VARIABLE _client_git_status ERROR_QUIET)
    if(NOT _client_status AND _client_git_status EQUAL 0)
        set(TETR_CLIENT_DIRTY false)
    endif()
endif()
if(TETR_DISTRIBUTION_COMMIT)
    set(TETR_CLIENT_COMMIT "${TETR_DISTRIBUTION_COMMIT}")
    if(TETR_DISTRIBUTION_DIRTY STREQUAL "false")
        set(TETR_CLIENT_DIRTY false)
    else()
        set(TETR_CLIENT_DIRTY true)
    endif()
endif()
if(NOT TETR_CLIENT_COMMIT MATCHES "^[0-9a-f]+$")
    set(TETR_CLIENT_COMMIT unknown)
    set(TETR_CLIENT_DIRTY true)
endif()
set(TETR_CLIENT_ARCH x86)
if(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(TETR_CLIENT_ARCH x64)
endif()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(TETR_CLIENT_ARCH arm64)
endif()
set(TETR_CLIENT_STATIC false)
if(TETR_PORTABLE_BUILD AND TETR_PORTABLE_FULL_STATIC AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(TETR_CLIENT_STATIC true)
endif()
foreach(TETR_CLIENT_FRONTEND terminal opengl bundle)
    if(TETR_CLIENT_FRONTEND STREQUAL "bundle" AND (NOT TARGET tetr OR NOT TARGET tetr_gl OR NOT TARGET tetr_server))
        continue()
    endif()
    if((TETR_CLIENT_FRONTEND STREQUAL "terminal" AND NOT TARGET tetr) OR
       (TETR_CLIENT_FRONTEND STREQUAL "opengl" AND NOT TARGET tetr_gl))
        continue()
    endif()
    if(TETR_CLIENT_FRONTEND STREQUAL "terminal")
        set(_component ClientTerminal)
        install(TARGETS tetr tetr_ft7 RUNTIME DESTINATION . COMPONENT ${_component})
    elseif(TETR_CLIENT_FRONTEND STREQUAL "bundle")
        set(_component ClientBundle)
        install(TARGETS tetr tetr_ft7 RUNTIME DESTINATION . COMPONENT ${_component})
    else()
        set(_component ClientOpenGL)
    endif()
    if(NOT TETR_CLIENT_FRONTEND STREQUAL "terminal")
        install(TARGETS tetr_gl RUNTIME DESTINATION . COMPONENT ${_component})
        install(DIRECTORY resources/fonts resources/licenses DESTINATION resources COMPONENT ${_component})
        install(FILES third_party/glad/LICENSE DESTINATION resources/licenses RENAME glad.txt COMPONENT ${_component})
        install(FILES docs/OPENGL_PREVIEW.md docs/FRONTEND_ACCEPTANCE.md DESTINATION docs COMPONENT ${_component})
        if(WIN32)
            get_target_property(_client_sdl_type SDL3::SDL3 TYPE)
            if(_client_sdl_type STREQUAL "SHARED_LIBRARY")
                install(FILES "$<TARGET_FILE:SDL3::SDL3>" DESTINATION . COMPONENT ${_component})
            endif()
        endif()
    endif()
    if(TARGET tetr_server)
        install(TARGETS tetr_server RUNTIME DESTINATION . COMPONENT ${_component})
    endif()
    configure_file(cmake/client/BUILD.json.in "client-${TETR_CLIENT_FRONTEND}-BUILD.json" @ONLY)
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/client-${TETR_CLIENT_FRONTEND}-BUILD.json"
        DESTINATION . RENAME BUILD.json COMPONENT ${_component})
    configure_file(cmake/client/Install.cmake.in "client-${TETR_CLIENT_FRONTEND}-install.cmake" @ONLY)
    install(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/client-${TETR_CLIENT_FRONTEND}-install.cmake" COMPONENT ${_component})
endforeach()
