# A normal Linux build can use a recent system libcurl. Portable packages and
# Windows build pinned static dependencies, without requiring extra DLLs.
set(_tetr_bundled_curl_default OFF)
if(WIN32 OR TETR_PORTABLE_BUILD)
    set(_tetr_bundled_curl_default ON)
endif()
option(TETR_BUNDLED_CURL "Build pinned libcurl with WebSocket/TLS support" ${_tetr_bundled_curl_default})

function(tetr_setup_websocket)
    # A fully static Linux binary must not load the host's glibc NSS modules
    # through either curl or our UDP resolver. Build both against pinned c-ares.
    set(_tetr_static_dns OFF)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND TETR_PORTABLE_BUILD AND TETR_PORTABLE_FULL_STATIC)
        set(_tetr_static_dns ON)
    endif()
    if(NOT TETR_BUNDLED_CURL AND NOT _tetr_static_dns)
        find_package(CURL 8.14 QUIET)
        if(CURL_FOUND)
            return()
        endif()
        message(STATUS "Recent libcurl unavailable; building bundled WebSocket dependencies")
    endif()
    include(FetchContent)
    # Keep third-party options local to this function. In particular their
    # BUILD_TESTING setting must not disable TerMino's regression suite.
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    if(POLICY CMP0126)
        set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
    endif()
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_STATIC_LIBS ON)
    set(BUILD_TESTING OFF)
    set(BUILD_EXAMPLES OFF)
    set(CURL_ENABLE_EXPORT_TARGET OFF)
    set(CURL_DISABLE_INSTALL ON)
    set(BUILD_CURL_EXE OFF)
    # Only the library is used; its manuals would require an unrelated Perl
    # installation and are neither built nor included in the portable package.
    set(BUILD_LIBCURL_DOCS OFF)
    set(BUILD_MISC_DOCS OFF)
    set(ENABLE_CURL_MANUAL OFF)
    set(PICKY_COMPILER OFF)
    set(CURL_USE_OPENSSL OFF)
    set(CURL_USE_GNUTLS OFF)
    set(CURL_USE_WOLFSSL OFF)
    set(CURL_USE_RUSTLS OFF)
    set(CURL_USE_PKGCONFIG OFF)
    set(CURL_USE_CMAKECONFIG OFF)
    set(CURL_USE_LIBPSL OFF)
    set(CURL_USE_LIBSSH2 OFF)
    set(CURL_USE_LIBSSH OFF)
    # These upstream settings are STRING cache entries, not option() BOOLs.
    # Set them explicitly even with older CMake cache policy behavior.
    set(CURL_ZLIB OFF CACHE STRING "Bundled curl compression disabled" FORCE)
    set(CURL_BROTLI OFF CACHE STRING "Bundled curl compression disabled" FORCE)
    set(CURL_ZSTD OFF CACHE STRING "Bundled curl compression disabled" FORCE)
    set(USE_LIBIDN2 OFF)
    set(USE_NGHTTP2 OFF)
    set(USE_NGTCP2 OFF)
    set(ENABLE_ARES OFF)
    set(ENABLE_THREADED_RESOLVER ON)
    if(_tetr_static_dns)
        set(CARES_STATIC ON)
        set(CARES_SHARED OFF)
        set(CARES_INSTALL OFF)
        set(CARES_BUILD_TESTS OFF)
        set(CARES_BUILD_CONTAINER_TESTS OFF)
        set(CARES_BUILD_TOOLS OFF)
        set(CARES_THREADS ON)
        FetchContent_Declare(tetr_cares
            URL https://github.com/c-ares/c-ares/releases/download/v1.34.8/c-ares-1.34.8.tar.gz
            URL_HASH SHA256=c222b6d681096f9444d2c4863d2c1174019e27cacca0a4a5c114d36dd7d7bf78)
        FetchContent_MakeAvailable(tetr_cares)
        set(CARES_INCLUDE_DIR "${tetr_cares_SOURCE_DIR}/include")
        set(CARES_LIBRARY c-ares::cares_static)
        set(CARES_USE_STATIC_LIBS ON)
        set(ENABLE_ARES ON)
        set(ENABLE_THREADED_RESOLVER OFF)
        # TerMino never uses netrc credentials; avoid its getpwuid_r/NSS path.
        set(CURL_DISABLE_NETRC ON)
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/websocket-licenses")
        configure_file("${tetr_cares_SOURCE_DIR}/LICENSE.md"
            "${CMAKE_BINARY_DIR}/websocket-licenses/c-ares.txt" COPYONLY)
        set(TETR_STATIC_DNS_ENABLED ON PARENT_SCOPE)
    endif()
    set(CURL_DISABLE_WEBSOCKETS OFF)
    foreach(protocol DICT FILE FTP GOPHER IMAP LDAP LDAPS MQTT POP3 RTSP SCP SFTP SMB SMTP TELNET TFTP)
        set(CURL_DISABLE_${protocol} ON)
    endforeach()
    if(WIN32)
        set(CURL_USE_SCHANNEL ON)
        set(CURL_USE_MBEDTLS OFF)
    else()
        set(ENABLE_PROGRAMS OFF)
        set(ENABLE_TESTING OFF)
        set(MBEDTLS_FATAL_WARNINGS OFF)
        set(USE_STATIC_MBEDTLS_LIBRARY ON)
        set(USE_SHARED_MBEDTLS_LIBRARY OFF)
        FetchContent_Declare(tetr_mbedtls
            URL https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.7/mbedtls-3.6.7.tar.bz2
            URL_HASH SHA256=a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6)
        FetchContent_MakeAvailable(tetr_mbedtls)
        # TLS 1.3 uses the shared PSA key store. Each WebSocket has its own
        # worker, so all Mbed TLS consumers must agree on the mutex-enabled
        # context layout, including curl's headers.
        foreach(_tetr_tls_target mbedcrypto mbedx509 mbedtls)
            target_compile_definitions(${_tetr_tls_target} PUBLIC MBEDTLS_THREADING_C MBEDTLS_THREADING_PTHREAD)
            target_link_libraries(${_tetr_tls_target} PUBLIC Threads::Threads)
        endforeach()
        set(CURL_USE_MBEDTLS ON)
        set(MBEDTLS_INCLUDE_DIR "${tetr_mbedtls_SOURCE_DIR}/include")
        set(MBEDTLS_LIBRARY mbedtls)
        set(MBEDX509_LIBRARY mbedx509)
        set(MBEDCRYPTO_LIBRARY mbedcrypto)
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/websocket-licenses")
        configure_file("${tetr_mbedtls_SOURCE_DIR}/LICENSE" "${CMAKE_BINARY_DIR}/websocket-licenses/MbedTLS.txt" COPYONLY)
    endif()
    FetchContent_Declare(tetr_curl
        URL https://curl.se/download/curl-8.22.0.tar.xz
        URL_HASH SHA256=f7ef3ae8a22e521f289803fe93543eb64c329b58aa73a9e224dfd915a2a5f4f7)
    FetchContent_MakeAvailable(tetr_curl)
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/websocket-licenses")
    configure_file("${tetr_curl_SOURCE_DIR}/COPYING" "${CMAKE_BINARY_DIR}/websocket-licenses/curl.txt" COPYONLY)
endfunction()
