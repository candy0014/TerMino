# One executable per module, with each CTest invocation still a fresh process.
function(tetr_test_program target)
    add_executable(${target} ${ARGN})
    set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/tests")
    if(MSVC)
        target_compile_options(${target} PRIVATE /UNDEBUG)
    else()
        target_compile_options(${target} PRIVATE -UNDEBUG)
    endif()
endfunction()

function(tetr_test_module target suite source)
    if(NOT TARGET ${suite})
        tetr_test_program(${suite} "${PROJECT_SOURCE_DIR}/tests/test_main.cpp")
        target_compile_definitions(${suite} PRIVATE TETR_TEST_REGISTRY="${suite}_registry.h")
        target_include_directories(${suite} PRIVATE "${PROJECT_BINARY_DIR}/test-suites")
        set_property(GLOBAL APPEND PROPERTY TETR_TEST_SUITES ${suite})
    endif()
    add_library(${target} OBJECT ${source})
    if(MSVC)
        target_compile_options(${target} PRIVATE /UNDEBUG)
    else()
        target_compile_options(${target} PRIVATE -UNDEBUG)
    endif()
    # Object targets retain each case's include paths, definitions and link
    # dependencies; they no longer produce a separate executable or archive.
    target_link_libraries(${suite} PRIVATE ${target})
    set_property(TARGET ${suite} APPEND PROPERTY TETR_TEST_CASES ${target})
endfunction()

function(tetr_finalize_test_suites)
    get_property(suites GLOBAL PROPERTY TETR_TEST_SUITES)
    foreach(suite IN LISTS suites)
        get_target_property(cases ${suite} TETR_TEST_CASES)
        set(declarations "")
        set(entries "")
        foreach(case IN LISTS cases)
            string(APPEND declarations "namespace TetrTests::${case} { int run(int, char**); }\n")
            string(APPEND entries "    {\"${case}\", TetrTests::${case}::run},\n")
        endforeach()
        file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/test-suites/${suite}_registry.h"
            CONTENT "${declarations}\nstatic const TestCase testCases[] = {\n${entries}};\n")
    endforeach()
endfunction()
