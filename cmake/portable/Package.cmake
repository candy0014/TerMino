cmake_minimum_required(VERSION 3.24)

if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "Run package.bat -Cmd on Windows or under Wine; use package.sh on Linux.")
endif()
get_filename_component(TETR_PACKAGE_SOURCE_DIR "${TETR_PACKAGE_SOURCE_DIR}" ABSOLUTE)
if(NOT TETR_PACKAGE_PARALLEL MATCHES "^[1-9][0-9]*$" OR TETR_PACKAGE_PARALLEL GREATER 256)
    message(FATAL_ERROR "Parallel jobs must be an integer from 1 to 256.")
endif()
if(NOT TETR_PACKAGE_GENERATOR)
    set(TETR_PACKAGE_GENERATOR "$ENV{CMAKE_GENERATOR}")
endif()
if(NOT TETR_PACKAGE_BUILD_DIR)
    set(_suffix vs)
    if(TETR_PACKAGE_GENERATOR)
        string(REGEX REPLACE "[^a-zA-Z0-9]+" "-" _suffix "${TETR_PACKAGE_GENERATOR}")
    endif()
    set(TETR_PACKAGE_BUILD_DIR "build-portable-windows-${_suffix}")
endif()
foreach(_path BUILD_DIR OUTPUT_DIR)
    get_filename_component(TETR_PACKAGE_${_path} "${TETR_PACKAGE_${_path}}"
        ABSOLUTE BASE_DIR "${TETR_PACKAGE_SOURCE_DIR}")
endforeach()
if(TETR_PACKAGE_DATA_DIR)
    message(STATUS "DataDirectory is ignored: packages always use defaults and empty data.")
endif()
find_package(Python3 3.12 REQUIRED COMPONENTS Interpreter)
set(_args "${Python3_EXECUTABLE}" "${TETR_PACKAGE_SOURCE_DIR}/tools/package_frontends.py"
    --build-dir "${TETR_PACKAGE_BUILD_DIR}" --configure --frontend bundle
    --parallel "${TETR_PACKAGE_PARALLEL}" --output-dir "${TETR_PACKAGE_OUTPUT_DIR}" --allow-dirty)
if(TETR_PACKAGE_GENERATOR)
    list(APPEND _args --generator "${TETR_PACKAGE_GENERATOR}")
endif()
execute_process(COMMAND ${_args} WORKING_DIRECTORY "${TETR_PACKAGE_SOURCE_DIR}" RESULT_VARIABLE _result COMMAND_ECHO STDOUT)
if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Package command failed (${_result}); no finished package was created.")
endif()
message(STATUS "Start terminal: Play.bat; graphics: PlayGL.bat; server: Server.bat")
