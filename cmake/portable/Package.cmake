cmake_minimum_required(VERSION 3.24)

if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "Run package.bat -Cmd on Windows or under Wine; use package.sh on Linux.")
endif()
get_filename_component(TETR_PACKAGE_SOURCE_DIR "${TETR_PACKAGE_SOURCE_DIR}" ABSOLUTE)
if(NOT TETR_PACKAGE_PARALLEL MATCHES "^[1-9][0-9]*$" OR TETR_PACKAGE_PARALLEL GREATER 256)
    message(FATAL_ERROR "Parallel jobs must be an integer from 1 to 256.")
endif()
if(NOT TETR_PACKAGE_GENERATOR)
    set(TETR_PACKAGE_GENERATOR "$ENV{CMAKE_GENERATOR}")
endif()
if(NOT TETR_PACKAGE_BUILD_DIR)
    set(_suffix vs)
    if(TETR_PACKAGE_GENERATOR)
        string(REGEX REPLACE "[^a-zA-Z0-9]+" "-" _suffix "${TETR_PACKAGE_GENERATOR}")
    endif()
    set(TETR_PACKAGE_BUILD_DIR "build-portable-windows-${_suffix}")
endif()
if(NOT TETR_PACKAGE_DATA_DIR)
    set(TETR_PACKAGE_DATA_DIR "${TETR_PACKAGE_SOURCE_DIR}")
endif()
foreach(_path BUILD_DIR OUTPUT_DIR DATA_DIR)
    get_filename_component(TETR_PACKAGE_${_path} "${TETR_PACKAGE_${_path}}"
        ABSOLUTE BASE_DIR "${TETR_PACKAGE_SOURCE_DIR}")
endforeach()
if(NOT IS_DIRECTORY "${TETR_PACKAGE_DATA_DIR}")
    message(FATAL_ERROR "Runtime data directory does not exist: ${TETR_PACKAGE_DATA_DIR}")
endif()

function(package_command)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE _result COMMAND_ECHO STDOUT)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "Package command failed (${_result}); no finished archive was created.")
    endif()
endfunction()
set(_configure -S "${TETR_PACKAGE_SOURCE_DIR}" -B "${TETR_PACKAGE_BUILD_DIR}"
    -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DTETR_PORTABLE_BUILD=ON
    -DTETR_PORTABLE_RESET_SETTINGS=ON
    -DCMAKE_SUPPRESS_REGENERATION=ON "-DTETR_PORTABLE_DATA_DIR=${TETR_PACKAGE_DATA_DIR}")
if(TETR_PACKAGE_GENERATOR)
    list(APPEND _configure -G "${TETR_PACKAGE_GENERATOR}")
endif()
if(DEFINED ENV{WINEPREFIX})
    # Bundled curl's manuals are disabled. Wine can otherwise discover Linux
    # /bin/perl and try to launch it as a Windows subprocess during configure.
    list(APPEND _configure -DCMAKE_DISABLE_FIND_PACKAGE_Perl=ON)
endif()
package_command("${CMAKE_COMMAND}" ${_configure})
package_command("${CMAKE_COMMAND}" --build "${TETR_PACKAGE_BUILD_DIR}" --config Release
    --target tetr tetr_server --parallel "${TETR_PACKAGE_PARALLEL}")
file(READ "${TETR_PACKAGE_BUILD_DIR}/portable-platform.txt" _platform)
string(STRIP "${_platform}" _platform)
string(TIMESTAMP _timestamp "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef _unique)
set(_name "TerMino-${_platform}-${_timestamp}-${_unique}")
set(_directory "${TETR_PACKAGE_OUTPUT_DIR}/${_name}")
if(EXISTS "${_directory}" OR EXISTS "${_directory}.zip")
    message(FATAL_ERROR "Package already exists: ${_directory}")
endif()
file(MAKE_DIRECTORY "${_directory}")
package_command("${CMAKE_COMMAND}" --install "${TETR_PACKAGE_BUILD_DIR}" --config Release
    --component Portable --prefix "${_directory}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${_directory}.zip" --format=zip "${_name}"
    WORKING_DIRECTORY "${TETR_PACKAGE_OUTPUT_DIR}" RESULT_VARIABLE _archive_result)
if(NOT _archive_result STREQUAL "0")
    message(FATAL_ERROR "Archive creation failed (${_archive_result}).")
endif()
file(SHA256 "${_directory}.zip" _checksum)
file(WRITE "${_directory}.zip.sha256" "${_checksum}  ${_name}.zip\n")
message(STATUS "Portable package: ${_directory}")
message(STATUS "Archive:          ${_directory}.zip")
message(STATUS "Start the game using Play.bat.")
