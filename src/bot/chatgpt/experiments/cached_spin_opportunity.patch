+#ifndef TETR_BOT_CHATGPT_OPPORTUNITY_H
+#define TETR_BOT_CHATGPT_OPPORTUNITY_H
+
+#include "search.h"
+
+namespace Bot_chatgpt {
+
+// A bounded, one-piece geometric certificate, not a guessed slot pattern.
+// Uses only a named visible piece and the real SRS+/Spin search. No future
+// garbage holes, hidden bag or imagined setup blocks are introduced.
+class SpinOpportunity {
+public:
+    void init(const m_tetris::TetrisContext* context) {
+        context_ = context;
+        search_.init(context, nullptr);
+    }
+    int best_lines(const m_tetris::TetrisMap& map, char type, bool previousCleared) {
+        if (piece_index(type) < 0) return 0;
+        const auto* start = spawn_node(context_, map, type, previousCleared);
+        if (!start) return 0;
+        int best = 0;
+        for (const auto& landing : *search_.search(map, start, 0)) {
+            if (!landing.spin) continue;
+            int lines = 0;
+            for (int y = 0; y < landing->height; ++y)
+                lines += (map.row[landing->row + y] | landing->data[y]) == context_->full();
+            best = std::max(best, lines);
+        }
+        return best;
+    }
+private:
+    const m_tetris::TetrisContext* context_ = nullptr;
+    Search search_;
+};
+}
+
+#endif
