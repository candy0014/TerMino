@@ -0,0 +1,53 @@
+// Deterministic work-count probe, not a replacement game simulator.
+// Compare identical tree expansion iterations with geometry caching on/off.
+#include "evaluation.h"
+#include "../native_host.h"
+#include "rule_tetr_srs_plus.h"
+#include <chrono>
+#include <cstdlib>
+#include <iostream>
+#include <random>
+
+int main(int argc, char** argv) {
+    using Engine = m_tetris::TetrisEngine<rule_tetr_srs_plus::TetrisRule,
+        Bot_chatgpt::Evaluation, Bot_chatgpt::Search>;
+    Engine engine;
+    if (!engine.prepare(10, 40)) return 1;
+    engine.memory_limit(256ull << 20);
+    const bool cache = argc < 2 || std::atoi(argv[1]) != 0;
+    engine.search_config()->cacheEnabled = cache;
+    std::mt19937 random(20260926);
+    std::uint64_t calls = 0, hits = 0, visited = 0, evaluations = 0;
+    double milliseconds = 0;
+    for (int sample = 0; sample < 12; ++sample) {
+        Runtime::Playfield field;
+        field.initialize(10, 20); field.clear();
+        for (int x = 0; x < 10; ++x) {
+            const int height = sample ? random() % 8 : 0;
+            for (int y = 20 - height; y < 20; ++y)
+                if (x != sample % 10) field.set_cell(y, x, Runtime::BoardCell::garbage());
+        }
+        const auto map = BotNativeHost::make_map(field);
+        *engine.status() = {};
+        if (sample) engine.update();
+        engine.search_config()->counters = {};
+        engine.ai()->reset_counters();
+        const auto begin = std::chrono::steady_clock::now();
+        const auto* start = engine.context()->generate('T');
+        engine.run_hold(map, start, 'I', true, "ZJSOLT", 6, 0);
+        for (int iteration = 0; iteration < 100; ++iteration) engine.run_hold();
+        const auto result = engine.run_hold(map, start, 'I', true, "ZJSOLT", 6, 0);
+        milliseconds += std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - begin).count();
+        const auto& c = engine.search_config()->counters;
+        calls += c.calls; hits += c.cacheHits; visited += c.visited;
+        for (auto count : engine.ai()->evaluatedByDepth) evaluations += count;
+        if (!result.target.node) return 2;
+        std::cout << "sample=" << sample << " target=" << result.target->index
+                  << " spin=" << result.target.spin << " mini=" << result.target.mini
+                  << " hold=" << result.change_hold << " value=" << result.status.value
+                  << " depth=" << result.status.placedPieces << '\n';
+    }
+    std::cout << "cache=" << cache << " ms=" << milliseconds << " calls=" << calls
+              << " hits=" << hits << " visited=" << visited << " evaluations=" << evaluations << '\n';
+}
